/**
 * Ghar Kharcha: Google Sheets-backed, owner-only personal expense app.
 * Create a Google Sheet > Extensions > Apps Script > add Code.gs,
 * Index.html, Styles.html and Client.html.
 * Run setupDatabase once FROM THE SCRIPT EDITOR before deploying.
 * Deploy with GitHub Actions, private access only. PIN config is generated privately during deployment.
 */
'use strict';

const SHEETS = Object.freeze({
  transactions: ['ID', 'Date', 'CategoryID', 'Amount', 'Note', 'Type', 'CreatedAt', 'UpdatedAt'],
  categories: ['ID', 'Name', 'Type'],
  plans: ['Month', 'Income', 'Budget'],
  categoryBudgets: ['CategoryID', 'Budget'],
  categoryBudgetOverrides: ['Month', 'CategoryID', 'Budget']
});
const SEED_CATEGORIES = [
  ['Plot EMI','expense'], ['Wifi','expense'], ['Gas','expense'],
  ['Mobile Recharge','expense'], ['Electricity Bill','expense'],
  ['Ration','expense'], ['Doc Visit','expense'], ['Petrol & Travel','expense'],
  ['LIC','expense'], ['Health Insurance','expense'], ['Bike Insurance','expense'],
  ['SIP','investment'], ['Credit Card Bill','transfer'], ['Milk','expense'],
  ['ChatGPT Subscription','expense'], ['Bike Service','expense'],
  ['Fast Food','expense'], ['Medicines','expense'], ['Other','expense']
];
const MAX_ENTRIES = 10000;
const LOGIN_WINDOW_MS = 15 * 60 * 1000;
const LOGIN_MAX_FAILURES = 5;
const LOGIN_SESSION_SECONDS = 3600;
/**
 * PrivatePin.gs is generated by GitHub Actions using APP_PIN (GitHub Secret).
 * Its HMAC key and digest are NEVER part of the public repository or HTML output.
 * Change APP_PIN in GitHub Actions secrets and run Deploy to rotate the PIN.
 */
function pinConfig_() {
  if (typeof PRIVATE_PIN_PEPPER === 'undefined' || typeof PRIVATE_PIN_DIGEST === 'undefined') {
    throw Error('PIN protection is not deployed. Configure GitHub Actions secrets and deploy first.');
  }
  return {pepper: PRIVATE_PIN_PEPPER, digest: PRIVATE_PIN_DIGEST};
}
function hex_(bytes) {
  return bytes.map(b => ('0' + ((b + 256) % 256).toString(16)).slice(-2)).join('');
}
function secureEquals_(a, b) {
  if (typeof a !== 'string' || typeof b !== 'string') return false;
  let diff = a.length ^ b.length;
  for (let i = 0; i < Math.max(a.length, b.length); i++) {
    diff |= (a.charCodeAt(i) || 0) ^ (b.charCodeAt(i) || 0);
  }
  return diff === 0;
}
/** PIN check is ONLY on Apps Script server. Script itself is available to owner only. */
function verifyPin(pin) {
  return lockRun_(function () {
    const config = pinConfig_();
    const props = PropertiesService.getScriptProperties();
    const now = Date.now();
    let status = {};
    try { status = JSON.parse(props.getProperty('GHAR_PIN_THROTTLE') || '{}'); } catch (_) { status = {}; }
    if (Number(status.lockedUntil) > now) {
      throw Error('Too many incorrect attempts. Try again after 15 minutes.');
    }
    const candidate = typeof pin === 'string' && /^\d{6,12}$/.test(pin) ? pin : '';
    const digest = hex_(Utilities.computeHmacSha256Signature(candidate, config.pepper));
    if (!candidate || !secureEquals_(digest, config.digest)) {
      const windowStart = Number(status.windowStart) || now;
      const inWindow = now - windowStart < LOGIN_WINDOW_MS;
      const failures = inWindow ? (Number(status.failures) || 0) + 1 : 1;
      const next = {failures:failures, windowStart:inWindow ? windowStart : now};
      if (failures >= LOGIN_MAX_FAILURES) next.lockedUntil = now + LOGIN_WINDOW_MS;
      props.setProperty('GHAR_PIN_THROTTLE', JSON.stringify(next));
      throw Error(failures >= LOGIN_MAX_FAILURES ? 'Too many incorrect attempts. Try again after 15 minutes.' : 'Incorrect PIN.');
    }
    props.deleteProperty('GHAR_PIN_THROTTLE');
    const sessionToken = 'session_' + Utilities.getUuid() + '_' + Utilities.getUuid();
    CacheService.getScriptCache().put('GHAR_SESSION_' + sessionToken, config.digest, LOGIN_SESSION_SECONDS);
    return {token: sessionToken};
  });
}
function requireSession_(token) {
  if (typeof token !== 'string' || !/^session_[a-f0-9-]{36}_[a-f0-9-]{36}$/.test(token) ||
      CacheService.getScriptCache().get('GHAR_SESSION_' + token) !== pinConfig_().digest) {
    throw Error('Session expired. Please unlock again.');
  }
}


function doGet() {
  return HtmlService.createTemplateFromFile('Index').evaluate()
    .setTitle('Ghar Kharcha | Personal Expense Tracker')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1, viewport-fit=cover');
}
function include(filename) {
  if (['Styles', 'Client'].indexOf(filename) === -1) throw Error('Invalid include.');
  return HtmlService.createHtmlOutputFromFile(filename).getContent();
}

/** Editor-only first-time setup. NEVER run again to overwrite anything; it's idempotent. */
function setupDatabase() {
  const active = SpreadsheetApp.getActiveSpreadsheet();
  if (!active) throw Error('Open the bound script from your Google Sheet (Extensions > Apps Script).');
  const savedId = PropertiesService.getScriptProperties().getProperty('GHAR_KHARCHA_SHEET_ID');
  if (savedId && savedId !== active.getId()) throw Error('Already configured for a different Sheet. Refusing to switch silently.');
  PropertiesService.getScriptProperties().setProperty('GHAR_KHARCHA_SHEET_ID', active.getId());
  const ss = SpreadsheetApp.openById(active.getId());
  Object.keys(SHEETS).forEach(key => {
    const name = sheetName_(key);
    let tab = ss.getSheetByName(name);
    if (!tab) tab = ss.insertSheet(name);
    const hdr = SHEETS[key];
    if (tab.getLastRow() === 0) {
      tab.getRange(1, 1, 1, hdr.length).setValues([hdr]);
      tab.getRange(1, 1, 1, hdr.length).setFontWeight('bold').setBackground('#dff3e8');
      tab.setFrozenRows(1);
    } else {
      const existing = tab.getRange(1, 1, 1, hdr.length).getDisplayValues()[0];
      if (existing.join('|') !== hdr.join('|')) throw Error('Unexpected header in tab ' + name + '. Check manually.');
    }
    // Store all columns as text except numeric Amount, Income, Budget.
    tab.getRange(2, 1, Math.max(tab.getMaxRows() - 1, 1), hdr.length).setNumberFormat('@');
    const numeric = key === 'transactions' ? [4] : key === 'plans' ? [2, 3] : key === 'categoryBudgets' ? [2] : key === 'categoryBudgetOverrides' ? [3] : [];
    numeric.forEach(c => tab.getRange(2, c, Math.max(tab.getMaxRows() - 1, 1), 1).setNumberFormat('#,##0.00'));
    tab.autoResizeColumns(1, hdr.length);
  });
  const categories = ss.getSheetByName('Categories');
  if (categories.getLastRow() === 1) {
    const rows = SEED_CATEGORIES.map((pair, i) => ['cat_' + i, pair[0], pair[1]]);
    categories.getRange(2, 1, rows.length, 3).setValues(rows);
  }
  SpreadsheetApp.flush();
  Logger.log('Setup completed. Spreadsheet: ' + ss.getUrl());
  return 'Setup completed.';
}

function sheetName_(key) { return {transactions:'Transactions', categories:'Categories', plans:'Plans',categoryBudgets:'CategoryBudgets',categoryBudgetOverrides:'CategoryBudgetOverrides'}[key]; }
function ensureBudgetSheets_(ss) {
  ['categoryBudgets','categoryBudgetOverrides'].forEach(key => {
    const name=sheetName_(key), headers=SHEETS[key];
    let sh=ss.getSheetByName(name);
    if(!sh){ sh=ss.insertSheet(name); }
    if(sh.getLastRow()===0){ sh.getRange(1,1,1,headers.length).setValues([headers]);sh.getRange(1,1,1,headers.length).setFontWeight('bold').setBackground('#dff3e8');sh.setFrozenRows(1);}
    else if(sh.getRange(1,1,1,headers.length).getDisplayValues()[0].join('|')!==headers.join('|')) throw Error('Unexpected budget tab headers: '+name);
  });
}

function db_() {
  const id = PropertiesService.getScriptProperties().getProperty('GHAR_KHARCHA_SHEET_ID');
  if (!id) throw Error('Database not configured. Run setupDatabase from the Apps Script editor once.');
  const ss=SpreadsheetApp.openById(id);
  // Add only the two new V3 budget tabs automatically; existing records stay untouched.
  ensureBudgetSheets_(ss);
  return ss;
}
function readRows_(ss, key) {
  const sh = ss.getSheetByName(sheetName_(key));
  if (!sh) throw Error('Missing tab: ' + sheetName_(key) + '. Run setupDatabase.');
  const length = sh.getLastRow() - 1;
  return length ? sh.getRange(2, 1, length, SHEETS[key].length).getDisplayValues() : [];
}
function asNumber_(v, label, max) {
  if (v === '' || v === null || typeof v === 'undefined') throw Error(label + ' is required.');
  const n = Number(v);
  if (!Number.isFinite(n) || n < 0 || (max !== undefined && n > max)) throw Error('Invalid ' + label + '.');
  return Math.round(n * 100) / 100;
}
function isDate_(d) {
  if (typeof d !== 'string' || !/^\d{4}-(0[1-9]|1[0-2])-\d{2}$/.test(d)) return false;
  const y = Number(d.slice(0,4)), m = Number(d.slice(5,7)), day = Number(d.slice(8,10));
  const dt = new Date(Date.UTC(y,m-1,day));
  return dt.getUTCFullYear()===y && dt.getUTCMonth()===m-1 && dt.getUTCDate()===day;
}
function isMonth_(m) { return typeof m === 'string' && /^\d{4}-(0[1-9]|1[0-2])$/.test(m); }
function text_(v, max, label, required) {
  const value = String(v == null ? '' : v).trim();
  if ((required && !value) || value.length > max) throw Error('Invalid ' + label + '.');
  return value;
}
function ensureRowCapacity_(sheet, count) {
  if (count > sheet.getMaxRows()) sheet.insertRowsAfter(sheet.getMaxRows(), count - sheet.getMaxRows());
}
function safeCell_(v) {
  // Avoid interpreting user-controlled names/notes as Google Sheets formulas.
  const s = String(v == null ? '' : v);
  return /^[=+@\-\t\r]/.test(s) ? "'" + s : s;
}
function allowedType_(k) { return ['expense','investment','transfer'].indexOf(k) >= 0; }
function guid_() { return Utilities.getUuid(); }
function stamp_() { return new Date().toISOString(); }
function lockRun_(fn) {
  const lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try { return fn(); } finally { lock.releaseLock(); }
}

function snapshot_(ss) {
  const categories = readRows_(ss, 'categories').filter(r => r[0] && r[1]).map(r => ({
    id:r[0],name:r[1],kind:allowedType_(r[2])?r[2]:'expense'
  }));
  const entries = readRows_(ss, 'transactions').filter(r => r[0] && isDate_(r[1])).map(r => ({
    id:r[0],date:r[1],categoryId:r[2],amount:Number(String(r[3]).replace(/,/g,''))||0,
    note:r[4]||'',kind:allowedType_(r[5])?r[5]:'expense',createdAt:r[6]||'',updatedAt:r[7]||''
  }));
  const plans = {};
  readRows_(ss, 'plans').forEach(r => {
    if (isMonth_(r[0])) {
      const p = {};
      if (r[1] !== '') p.income = Number(String(r[1]).replace(/,/g,''));
      if (r[2] !== '') p.budget = Number(String(r[2]).replace(/,/g,''));
      plans[r[0]] = p;
    }
  });
  const categoryBudgets={};
  readRows_(ss,'categoryBudgets').forEach(r=>{
    if(r[0] && r[1]!=='' && Number.isFinite(Number(String(r[1]).replace(/,/g,'')))) categoryBudgets[r[0]]=Number(String(r[1]).replace(/,/g,''));
  });
  const categoryBudgetOverrides={};
  readRows_(ss,'categoryBudgetOverrides').forEach(r=>{
    if(isMonth_(r[0]) && r[1] && r[2]!=='' && Number.isFinite(Number(String(r[2]).replace(/,/g,'')))) {
      if(!categoryBudgetOverrides[r[0]])categoryBudgetOverrides[r[0]]={};
      categoryBudgetOverrides[r[0]][r[1]]=Number(String(r[2]).replace(/,/g,''));
    }
  });
  return {version:3, entries:entries, categories:categories, plans:plans, categoryBudgets, categoryBudgetOverrides};
}
/** Called on app startup and by Refresh. */
function getAppData(session) { requireSession_(session); return snapshot_(db_()); }

function saveEntry(session, raw) {
  requireSession_(session);
  return lockRun_(function() {
    if (!raw || typeof raw !== 'object') throw Error('Invalid entry.');
    const ss = db_();
    const categoryId = text_(raw.categoryId, 100, 'category', true);
    const category = snapshotCategories_(ss).find(c => c.id === categoryId);
    if (!category) throw Error('Category was not found. Refresh the app.');
    const date = text_(raw.date, 10, 'date', true);
    if (!isDate_(date)) throw Error('Invalid date.');
    const amount = asNumber_(raw.amount, 'amount', 999999999);
    if (amount <= 0) throw Error('Amount must be greater than zero.');
    const note = text_(raw.note, 160, 'note', false);
    const sh = ss.getSheetByName('Transactions');
    const id = raw.id ? text_(raw.id, 100, 'ID', true) : guid_();
    const rows = readRows_(ss, 'transactions');
    const rowIndex = rows.findIndex(row => row[0] === id);
    if (raw.id && rowIndex < 0) throw Error('Entry no longer exists. Refresh.');
    if (!raw.id && rows.length >= MAX_ENTRIES) throw Error('Entry limit reached. Export your data before archiving.');
    const created = rowIndex < 0 ? stamp_() : rows[rowIndex][6];
    const values = [safeCell_(id),date,safeCell_(categoryId),amount,safeCell_(note),category.kind,created,stamp_()];
    if (rowIndex < 0) sh.appendRow(values);
    else sh.getRange(rowIndex + 2, 1, 1, 8).setValues([values]);
    SpreadsheetApp.flush();
    return snapshot_(ss);
  });
}
function snapshotCategories_(ss) {
  return readRows_(ss, 'categories').filter(r => r[0] && r[1]).map(r=>({id:r[0],name:r[1],kind:r[2]}));
}
function deleteEntry(session, id) {
  requireSession_(session);
  return lockRun_(function() {
    const ss=db_(), sh=ss.getSheetByName('Transactions');
    const row=readRows_(ss,'transactions').findIndex(r=>r[0]===String(id));
    if (row < 0) throw Error('Entry not found. Refresh app.');
    sh.deleteRow(row + 2);
    SpreadsheetApp.flush();
    return snapshot_(ss);
  });
}
function savePlan(session, month, raw) {
  requireSession_(session);
  return lockRun_(function() {
    if (!isMonth_(month)) throw Error('Invalid month.');
    const ss = db_(), sh=ss.getSheetByName('Plans');
    if (!raw || typeof raw !== 'object') throw Error('Invalid plan.');
    const inc = raw.income === '' || raw.income == null ? '' : asNumber_(raw.income,'income',999999999);
    const budget = raw.budget === '' || raw.budget == null ? '' : asNumber_(raw.budget,'budget',999999999);
    const rows=readRows_(ss,'plans'), index=rows.findIndex(r=>r[0]===month);
    const vals=[month, inc, budget];
    if(index<0) sh.appendRow(vals); else sh.getRange(index+2,1,1,3).setValues([vals]);
    SpreadsheetApp.flush();return snapshot_(ss);
  });
}
function addCategory(session, name, kind) {
  requireSession_(session);
  return lockRun_(function() {
    const ss=db_(), categories=snapshotCategories_(ss);
    const clean=text_(name,36,'category name',true);
    if (!allowedType_(kind)) throw Error('Invalid category type.');
    if (categories.some(c=>c.name.toLowerCase()===clean.toLowerCase())) throw Error('Category already exists.');
    if (categories.length>=150) throw Error('Category limit reached.');
    ss.getSheetByName('Categories').appendRow([guid_(),safeCell_(clean),kind]);
    SpreadsheetApp.flush();return snapshot_(ss);
  });
}

/** Rename a category without changing its ID (historic transactions remain intact). */
function updateCategory(session, id, name, kind) {
  requireSession_(session);
  return lockRun_(function() {
    const ss=db_(), cats=snapshotCategories_(ss), rows=readRows_(ss,'categories');
    const cleanId=text_(id,100,'category ID',true), clean=text_(name,36,'category name',true);
    if(!allowedType_(kind))throw Error('Invalid category type.');
    const index=rows.findIndex(r=>r[0]===cleanId);
    if(index<0)throw Error('Category not found. Refresh.');
    if(cats.some(c=>c.id!==cleanId && c.name.toLowerCase()===clean.toLowerCase()))throw Error('Category name already exists.');
    const old=cats.find(c=>c.id===cleanId);
    if(old.kind!==kind && readRows_(ss,'transactions').some(r=>r[2]===cleanId))throw Error('This category has transactions. Its type cannot change; its name can be edited.');
    if(old.kind==='expense'&&kind!=='expense'){
      const defaults=readRows_(ss,'categoryBudgets');
      const overrides=readRows_(ss,'categoryBudgetOverrides');
      if(defaults.some(r=>r[0]===cleanId)||overrides.some(r=>r[1]===cleanId))throw Error('Remove this category’s budget settings before changing its type.');
    }
    ss.getSheetByName('Categories').getRange(index+2,1,1,3).setValues([[safeCell_(cleanId),safeCell_(clean),kind]]);
    SpreadsheetApp.flush();return snapshot_(ss);
  });
}
/** Blank input removes a rule. A 0 budget is an intentional zero limit. */
function saveCategoryBudget(session, categoryId, scope, month, value) {
  requireSession_(session);
  return lockRun_(function() {
    const ss=db_(), id=text_(categoryId,100,'category ID',true);
    const cat=snapshotCategories_(ss).find(c=>c.id===id);
    if(!cat || cat.kind!=='expense')throw Error('Only expense categories can have spending budgets.');
    if(scope!=='default'&&scope!=='month')throw Error('Invalid budget scope.');
    if(scope==='month'&&!isMonth_(month))throw Error('Invalid month.');
    const clear=value===''||value===null||typeof value==='undefined';
    const budget=clear?null:asNumber_(value,'category budget',999999999);
    const key=scope==='default'?'categoryBudgets':'categoryBudgetOverrides';
    const sh=ss.getSheetByName(sheetName_(key)),rows=readRows_(ss,key);
    const index=rows.findIndex(r=>scope==='default'?r[0]===id:r[0]===month&&r[1]===id);
    if(clear){if(index>=0)sh.deleteRow(index+2);}
    else {
      const values=scope==='default'?[safeCell_(id),budget]:[month,safeCell_(id),budget];
      if(index>=0)sh.getRange(index+2,1,1,values.length).setValues([values]);else sh.appendRow(values);
    }
    SpreadsheetApp.flush();return snapshot_(ss);
  });
}

function validateSnapshot_(raw) {
  if (!raw || !Array.isArray(raw.entries) || !Array.isArray(raw.categories) || !raw.plans || Array.isArray(raw.plans) || typeof raw.plans !== 'object') throw Error('Invalid backup format.');
  if (raw.entries.length > MAX_ENTRIES || raw.categories.length > 150) throw Error('Backup is too large.');
  const categories=raw.categories.map(c=>({
    id:text_(c.id,100,'category ID',true), name:text_(c.name,36,'category name',true), kind:c.kind
  }));
  if (!categories.length || categories.some(c=>!allowedType_(c.kind))) throw Error('Invalid categories.');
  const categoryIds = new Set(categories.map(c=>c.id));
  if(categoryIds.size!==categories.length) throw Error('Duplicate category IDs.');
  const uniqueEntries = new Set();
  const entries = raw.entries.map(e=>{
    const id = text_(e.id,100,'entry ID',true),date=text_(e.date,10,'date',true),categoryId=text_(e.categoryId,100,'category ID',true);
    if (!isDate_(date)||!categoryIds.has(categoryId)||uniqueEntries.has(id))throw Error('Invalid date, missing category, or duplicate entry ID.');
    uniqueEntries.add(id);
    const amount=asNumber_(e.amount,'amount',999999999);
    if(amount<=0||!allowedType_(e.kind))throw Error('Invalid expense amount/type.');
    return {id,date,categoryId,amount,note:text_(e.note,160,'note',false),kind:e.kind,
      createdAt:String(e.createdAt||stamp_()).slice(0,40),updatedAt:String(e.updatedAt||stamp_()).slice(0,40)};
  });
  const plans={};
  Object.keys(raw.plans).forEach(month=>{
    if (!isMonth_(month)) throw Error('Invalid plan month.');
    const p=raw.plans[month];
    if(!p || typeof p!=='object')throw Error('Invalid plan.');
    plans[month]={
      income:p.income==null||p.income===''?'':asNumber_(p.income,'income',999999999),
      budget:p.budget==null||p.budget===''?'':asNumber_(p.budget,'budget',999999999)
    };
  });
  const defaultRules={}, overrideRules={};
  const rawDefaults=raw.categoryBudgets||{}, rawOverrides=raw.categoryBudgetOverrides||{};
  if(!rawDefaults||Array.isArray(rawDefaults)||typeof rawDefaults!=='object'||!rawOverrides||Array.isArray(rawOverrides)||typeof rawOverrides!=='object')throw Error('Invalid category budget backup.');
  for(const [id,v] of Object.entries(rawDefaults)) {
    const c=categories.find(x=>x.id===id);if(!c||c.kind!=='expense')throw Error('Invalid budget category.');
    defaultRules[id]=asNumber_(v,'default category budget',999999999);
  }
  for(const [m,rules] of Object.entries(rawOverrides)) {
    if(!isMonth_(m)||!rules||Array.isArray(rules)||typeof rules!=='object')throw Error('Invalid month override.');
    overrideRules[m]={};
    for(const [id,v] of Object.entries(rules)) {
      const c=categories.find(x=>x.id===id);if(!c||c.kind!=='expense')throw Error('Invalid override category.');
      overrideRules[m][id]=asNumber_(v,'monthly category budget',999999999);
    }
  }
  if(Object.keys(defaultRules).length>150 || Object.values(overrideRules).reduce((t,x)=>t+Object.keys(x).length,0)>3000)throw Error('Too many category budget rows.');
  return {entries,categories,plans,categoryBudgets:defaultRules,categoryBudgetOverrides:overrideRules};
}
function replaceData_(ss,clean) {
  // Confirmed backup/restore operation. Restore is NOT an atomic Sheets transaction.
  const map={
    categories:clean.categories.map(c=>[safeCell_(c.id),safeCell_(c.name),c.kind]),
    transactions:clean.entries.map(e=>[safeCell_(e.id),e.date,safeCell_(e.categoryId),e.amount,safeCell_(e.note),e.kind,e.createdAt,e.updatedAt]),
    plans:Object.keys(clean.plans).sort().map(m=>[m,clean.plans[m].income,clean.plans[m].budget]),
    categoryBudgets:Object.entries(clean.categoryBudgets||{}).map(([id,n])=>[safeCell_(id),n]),
    categoryBudgetOverrides:Object.entries(clean.categoryBudgetOverrides||{}).flatMap(([m,rules])=>Object.entries(rules).map(([id,n])=>[m,safeCell_(id),n]))
  };
  Object.keys(map).forEach(key=>{
    const sh=ss.getSheetByName(sheetName_(key));
    const last=sh.getLastRow();
    if(last>1)sh.getRange(2,1,last-1,SHEETS[key].length).clearContent();
    if (map[key].length) {
      ensureRowCapacity_(sh, map[key].length + 1);
      sh.getRange(2,1,map[key].length,SHEETS[key].length).setValues(map[key]);
    }
    // Sheet max row count may be greater than used rows; this is safe.
  });
  SpreadsheetApp.flush();
}
/** DANGEROUS: Completely replace cloud records. Client requests confirmation first. */
function restoreBackup(session, raw) {
  requireSession_(session);
  return lockRun_(function() {
    const clean = validateSnapshot_(raw); // Validate everything BEFORE changing the sheet.
    const ss=db_();
    replaceData_(ss,clean);
    return snapshot_(ss);
  });
}
/** Append compatible CSV transaction rows (client parses CSV). */
function importTransactions(session, raw) {
  requireSession_(session);
  return lockRun_(function() {
    if (!Array.isArray(raw) || raw.length<1 || raw.length>1000) throw Error('Import 1–1000 rows at a time.');
    const ss=db_(), cats=snapshotCategories_(ss), existing=readRows_(ss,'transactions');
    if (existing.length+raw.length>MAX_ENTRIES) throw Error('Entry limit reached.');
    const newCats=[], incoming=[], now=stamp_();
    raw.forEach(r=>{
      if (!r || typeof r !== 'object') throw Error('Invalid CSV row.');
      const date=text_(r.date,10,'date',true), name=text_(r.category,36,'category',true);
      if(!isDate_(date)) throw Error('Invalid CSV date: '+date);
      let cat=cats.find(c=>c.name.toLowerCase()===name.toLowerCase());
      if(!cat){cat={id:guid_(),name,kind:'expense'};cats.push(cat);newCats.push(cat);}
      const amount=asNumber_(r.amount,'amount',999999999);
      if(amount<=0)throw Error('Invalid CSV amount.');
      const kind=r.kind&&allowedType_(r.kind)?r.kind:cat.kind;
      incoming.push([guid_(),date,cat.id,amount,safeCell_(text_(r.note,160,'note',false)),kind,now,now]);
    });
    if(cats.length>150)throw Error('Too many categories.');
    if(newCats.length){
      const sh=ss.getSheetByName('Categories');
      ensureRowCapacity_(sh, sh.getLastRow()+newCats.length);
      sh.getRange(sh.getLastRow()+1,1,newCats.length,3).setValues(newCats.map(c=>[c.id,safeCell_(c.name),c.kind]));
    }
    const sh=ss.getSheetByName('Transactions');
    ensureRowCapacity_(sh, sh.getLastRow()+incoming.length);
    sh.getRange(sh.getLastRow()+1,1,incoming.length,8).setValues(incoming);
    SpreadsheetApp.flush();return snapshot_(ss);
  });
}
/** Resets all cloud records. Use only after making an external backup. */
function clearAllData(session) {
  requireSession_(session);
  return lockRun_(function() {
    const ss=db_();
    const clean={entries:[],categories:SEED_CATEGORIES.map((p,i)=>({id:'cat_'+i,name:p[0],kind:p[1]})),plans:{},categoryBudgets:{},categoryBudgetOverrides:{}};
    replaceData_(ss,clean);return snapshot_(ss);
  });
}
